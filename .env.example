# Supabase project (Project Settings → API). The anon/publishable key is safe in the browser:
# every permission is enforced by Row Level Security. NEVER put the service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Brand placeholder until the final name is chosen
VITE_APP_NAME=Tribu T1
VITE_APP_SHORT_NAME=Tribu T1

# Public URL of the deployed app (used for auth email redirects)
VITE_SITE_URL=http://localhost:5173
